diff --git a/Tests/AskiTests/FallbackNoiseCacheTests.swift b/Tests/AskiTests/FallbackNoiseCacheTests.swift
new file mode 100644
index 0000000..d17ffe9
--- /dev/null
+++ b/Tests/AskiTests/FallbackNoiseCacheTests.swift
@@ -0,0 +1,51 @@
+import CoreGraphics
+import CoreImage
+import Testing
+@testable import Aski
+
+/// ASKI-95 candidate: the fallback noise cache stays within its byte bound and
+/// returns the stored image for a repeated extent and seed.
+@Suite(.serialized) struct FallbackNoiseCacheTests {
+    @Test func retainedBytesStayWithinTheBound() {
+        FallbackNoiseCache.removeAll()
+        defer { FallbackNoiseCache.removeAll() }
+        let extent = CGRect(x: 0, y: 0, width: 1920, height: 1080)
+        var builds = 0
+        for seed in UInt64(0)..<6 {
+            _ = FallbackNoiseCache.noise(extent: extent, seed: seed) {
+                builds += 1
+                return CIImage(color: .gray).cropped(to: extent)
+            }
+            #expect(FallbackNoiseCache.retainedBytes <= FallbackNoiseCache.byteLimit)
+        }
+        #expect(builds == 6)
+        let oversized = CGRect(x: 0, y: 0, width: 4096, height: 4096)
+        for _ in 0..<2 {
+            _ = FallbackNoiseCache.noise(extent: oversized, seed: 0) {
+                builds += 1
+                return CIImage(color: .gray).cropped(to: oversized)
+            }
+            #expect(FallbackNoiseCache.retainedBytes <= FallbackNoiseCache.byteLimit)
+        }
+        // A raster above the bound is rebuilt each time rather than retained.
+        #expect(builds == 8)
+    }
+
+    @Test func repeatedKeyReturnsTheStoredImageAndOtherInputsMiss() {
+        FallbackNoiseCache.removeAll()
+        defer { FallbackNoiseCache.removeAll() }
+        let extent = CGRect(x: 0, y: 0, width: 32, height: 24)
+        var builds = 0
+        let make = { () -> CIImage in
+            builds += 1
+            return CIImage(color: .gray).cropped(to: extent)
+        }
+        let first = FallbackNoiseCache.noise(extent: extent, seed: 1, make: make)
+        let second = FallbackNoiseCache.noise(extent: extent, seed: 1, make: make)
+        #expect(first === second)
+        _ = FallbackNoiseCache.noise(extent: extent, seed: 2, make: make)
+        _ = FallbackNoiseCache.noise(extent: extent.offsetBy(dx: 1, dy: 0), seed: 1, make: make)
+        _ = FallbackNoiseCache.noise(extent: CGRect(x: 0, y: 0, width: 32.5, height: 24), seed: 1, make: make)
+        #expect(builds == 4)
+    }
+}
