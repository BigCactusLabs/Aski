new file mode 100644
index 0000000..2f6df07
--- /dev/null
+++ b/Sources/Aski/Effects/Internal/FallbackNoiseCache.swift
@@ -0,0 +1,64 @@
+import CoreImage
+import os
+
+/// Process-wide reuse of the Core Image fallback's seeded noise rasters
+/// (ASKI-95). Entries are keyed by the exact output extent and seed, the only
+/// inputs `seededNoise` reads, and hold the immutable image it returned.
+/// Retained raster bytes stay at or below `byteLimit`: least recently used
+/// entries are evicted first, and a raster larger than the limit is never kept.
+/// Entries otherwise live for the life of the process.
+internal enum FallbackNoiseCache {
+    static let byteLimit = 16 * 1024 * 1024
+
+    private struct Key: Hashable, Sendable {
+        let x: CGFloat
+        let y: CGFloat
+        let width: CGFloat
+        let height: CGFloat
+        let seed: UInt64
+    }
+
+    // CIImage is immutable and safe to share across threads.
+    private struct Entry: @unchecked Sendable {
+        let key: Key
+        let image: CIImage
+        let bytes: Int
+    }
+
+    /// Least recently used first.
+    private static let entries = OSAllocatedUnfairLock<[Entry]>(initialState: [])
+
+    static func noise(extent: CGRect, seed: UInt64, make: () -> CIImage) -> CIImage {
+        let bytes = max(1, Int(ceil(extent.width))) * max(1, Int(ceil(extent.height))) * 4
+        guard bytes <= byteLimit else { return make() }
+        let key = Key(x: extent.minX, y: extent.minY, width: extent.width, height: extent.height, seed: seed)
+        let cached = entries.withLock { entries -> Entry? in
+            guard let index = entries.firstIndex(where: { $0.key == key }) else { return nil }
+            let entry = entries.remove(at: index)
+            entries.append(entry)
+            return entry
+        }
+        if let cached { return cached.image }
+
+        // Build outside the lock. A concurrent builder of the same key makes
+        // identical bytes; the first stored entry wins.
+        let candidate = Entry(key: key, image: make(), bytes: bytes)
+        return entries.withLock { entries -> Entry in
+            if let existing = entries.first(where: { $0.key == key }) { return existing }
+            entries.append(candidate)
+            var total = entries.reduce(0) { $0 + $1.bytes }
+            while total > byteLimit {
+                total -= entries.removeFirst().bytes
+            }
+            return candidate
+        }.image
+    }
+
+    static var retainedBytes: Int {
+        entries.withLock { $0.reduce(0) { $0 + $1.bytes } }
+    }
+
+    static func removeAll() {
+        entries.withLock { $0.removeAll() }
+    }
+}
