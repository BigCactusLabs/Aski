{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aski.local/schemas/aski-product-probe-source-v1.schema.json",
  "title": "Aski product-probe private source manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "probeOrdinal", "sources"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "probeOrdinal": { "type": "integer", "enum": [1, 2] },
    "sources": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "role", "contentClass"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "enum": ["identity", "job"] },
          "contentClass": { "type": "string", "enum": ["portrait", "cover", "live"] },
          "participantId": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
